\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gridauto}[2026/10/22 v0.3 scoped baseline-grid disable]

% This package is a controlled, best-effort grid helper for standard
% article/report/book documents. It requires LuaLaTeX and returntogrid.
% It is not a universal page-output replacement; see the limitations below.

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{gridauto}{LuaLaTeX is required}{Compile this document with LuaLaTeX.}
\fi

\newif\ifGridAutoDebug
\GridAutoDebugfalse
\DeclareOption{debug}{\GridAutoDebugtrue}
\ProcessOptions\relax

\RequirePackage{etoolbox}
\RequirePackage{amsmath}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{returntogrid}

% Save pre-grid settings so a scoped disable can locally restore the normal
% baseline, display skips, title spacing and page-bottom behaviour.
\newlength{\GridAutoNaturalBaseline}
\newlength{\GridAutoOriginalTopskip}
\newlength{\GridAutoOriginalParskip}
\newskip\GridAutoOriginalAboveDisplaySkip
\newskip\GridAutoOriginalBelowDisplaySkip
\newskip\GridAutoOriginalAboveDisplayShortSkip
\newskip\GridAutoOriginalBelowDisplayShortSkip
\newskip\GridAutoOriginalAboveCaptionSkip
\newskip\GridAutoOriginalBelowCaptionSkip
\newlength{\GridAutoOriginalJot}
\setlength{\GridAutoNaturalBaseline}{12pt}
\setlength{\GridAutoOriginalTopskip}{\topskip}
\setlength{\GridAutoOriginalParskip}{\parskip}
\GridAutoOriginalAboveDisplaySkip=\abovedisplayskip
\GridAutoOriginalBelowDisplaySkip=\belowdisplayskip
\GridAutoOriginalAboveDisplayShortSkip=\abovedisplayshortskip
\GridAutoOriginalBelowDisplayShortSkip=\belowdisplayshortskip
\GridAutoOriginalAboveCaptionSkip=\abovecaptionskip
\GridAutoOriginalBelowCaptionSkip=\belowcaptionskip
\setlength{\GridAutoOriginalJot}{\jot}

\makeatletter
\let\GridAutoOriginalTextBottom\@textbottom
\@ifundefined{ttls@section}{}{\let\GridAutoOriginalSectionSpacing\ttls@section}
\@ifundefined{ttls@subsection}{}{\let\GridAutoOriginalSubsectionSpacing\ttls@subsection}
\@ifundefined{ttls@subsubsection}{}{\let\GridAutoOriginalSubsubsectionSpacing\ttls@subsubsection}
\@ifundefined{enit@@list}{\let\GridAutoOriginalListSpacing\relax}{\let\GridAutoOriginalListSpacing\enit@@list}
\makeatother

\newlength{\GridStep}
\setlength{\GridStep}{14pt}
\newif\ifGridAutoEnabled
\newif\ifGridAutoPending
\newif\ifGridAutoBusy
\newif\ifGridAutoHeadingActive
\newcounter{GridAutoHeading}
\GridAutoEnabledtrue
\GridAutoPendingfalse
\GridAutoBusyfalse
\GridAutoHeadingActivefalse

% Unique, repeatable labels for each heading across compilations.
\newcommand{\GridAutoHeadingLabel}{gridauto-heading-\arabic{GridAutoHeading}}
\newcommand{\GridAutoHeadingSave}{\returntogrid[save=\GridAutoHeadingLabel]}
\newcommand{\GridAutoBeforeHeading}{%
  \ifGridAutoEnabled
    \global\GridAutoPendingfalse
    \stepcounter{GridAutoHeading}%
    \returntogrid[use=\GridAutoHeadingLabel]%
    \global\GridAutoHeadingActivetrue
  \fi
}

% Public setup command: use in the preamble, e.g. \GridAutoSetup{14pt}.
\newcommand{\GridAutoSetup}[1]{%
  \setlength{\GridStep}{#1}%
  \setlength{\topskip}{\GridStep}%
  \setlength{\parskip}{0pt}%
  \raggedbottom
  \returntogridsetup{step=\GridStep,offset=\topskip}%
}
\GridAutoSetup{14pt}

\newcommand{\GridAutoMark}{%
  \ifGridAutoEnabled\global\GridAutoPendingtrue\fi
}

\makeatletter

% Disable the grid locally. Use in a brace group or through the gridautoff
% environment; assignments intentionally remain local except stale pending
% corrections, which are cleared so they cannot leak past the excluded block.
\newcommand{\GridAutoOff}{%
  \GridAutoEnabledfalse
  \global\GridAutoPendingfalse
  \global\GridAutoHeadingActivefalse
  \baselineskip=\GridAutoNaturalBaseline\relax
  \topskip=\GridAutoOriginalTopskip\relax
  \parskip=\GridAutoOriginalParskip\relax
  \abovedisplayskip=\GridAutoOriginalAboveDisplaySkip
  \belowdisplayskip=\GridAutoOriginalBelowDisplaySkip
  \abovedisplayshortskip=\GridAutoOriginalAboveDisplayShortSkip
  \belowdisplayshortskip=\GridAutoOriginalBelowDisplayShortSkip
  \abovecaptionskip=\GridAutoOriginalAboveCaptionSkip
  \belowcaptionskip=\GridAutoOriginalBelowCaptionSkip
  \jot=\GridAutoOriginalJot
  \let\@textbottom\GridAutoOriginalTextBottom
  \@ifundefined{GridAutoOriginalSectionSpacing}{}{%
    \let\ttls@section\GridAutoOriginalSectionSpacing}%
  \@ifundefined{GridAutoOriginalSubsectionSpacing}{}{%
    \let\ttls@subsection\GridAutoOriginalSubsectionSpacing}%
  \@ifundefined{GridAutoOriginalSubsubsectionSpacing}{}{%
    \let\ttls@subsubsection\GridAutoOriginalSubsubsectionSpacing}%
  \let\enit@@list\GridAutoOriginalListSpacing
}
\let\GridAutoDisable\GridAutoOff
\newenvironment{gridautoff}{\GridAutoOff}{}

% Place the correction BEFORE a heading, outside titlesec's internal title
% box, and save a position at the actual title baseline. This keeps the
% heading itself on the grid instead of shifting the following paragraph.
\@ifundefined{ttl@select}{}{%
  \let\GridAutoOriginalTtlSelect\ttl@select
  \def\ttl@select#1#2#3#4{%
    \ifGridAutoHeadingActive
      \GridAutoOriginalTtlSelect{#1}{#2}{#3}{\GridAutoHeadingSave#4}%
      \global\GridAutoHeadingActivefalse
    \else
      \GridAutoOriginalTtlSelect{#1}{#2}{#3}{#4}%
    \fi
  }%
}

% In-flow headings: include starred and unstarred forms automatically.
\pretocmd{\section}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook section}}
\pretocmd{\subsection}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook subsection}}
\pretocmd{\subsubsection}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook subsubsection}}
\pretocmd{\paragraph}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook paragraph}}
\pretocmd{\subparagraph}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook subparagraph}}

% Page-opening chapter/part headings use class-specific vertical layouts.
% Do not let a pending correction from a preceding block leak into them and
% unexpectedly move the chapter/part title or its following text. Their own
% title-page geometry is intentionally left to the document class.
\@ifundefined{chapter}{}{%
  \pretocmd{\chapter}{\global\GridAutoPendingfalse}{}{}
}
\@ifundefined{part}{}{%
  \pretocmd{\part}{\global\GridAutoPendingfalse}{}{}
}

% Keep each normal paragraph's baseline interval on an integer multiple
% of the grid. Very large font sizes use two grid steps to avoid collisions.
\AddToHook{selectfont}{%
  % Capture the font's natural leading before applying the grid override.
  \GridAutoNaturalBaseline=\baselineskip
  \ifGridAutoEnabled
    \dimen@=\f@size pt\relax
    \ifdim\dimen@>\GridStep
      \baselineskip=2\GridStep
    \else
      \baselineskip=\GridStep
    \fi
    \lineskip=0pt
    \lineskiplimit=-1000pt
  \fi
}

% If a standard block ended, snap the following main-text paragraph to the
% grid. Do not insert a correction inside an inner box/minipage.
\AddToHook{para/begin}{%
  \ifGridAutoEnabled
    \ifGridAutoPending
      \ifinner
        % Keep the flag pending; a correction inside a box is unsafe.
      \else
        \global\GridAutoPendingfalse
        \ifGridAutoBusy\else
          \global\GridAutoBusytrue
          \returntogrid
          \global\GridAutoBusyfalse
        \fi
      \fi
    \fi
  \fi
}

% Force ordinary figure/table environments to remain in source order.
% This is necessary because a relocated top float can break the grid.
% Double-column floats are not forced and produce warnings below.
\let\GridAutoOriginalXfloat\@xfloat
\def\@xfloat#1[#2]{%
  \ifGridAutoEnabled
    \ifstrequal{#1}{figure}{\GridAutoOriginalXfloat#1[H]}{%
      \ifstrequal{#1}{table}{\GridAutoOriginalXfloat#1[H]}{%
        \GridAutoOriginalXfloat#1[#2]}%
    }%
  \else
    \GridAutoOriginalXfloat#1[#2]%
  \fi
}
\makeatother

% Textual block spacing.
\AtBeginDocument{%
  \setlength{\parskip}{0pt}%
  \setlength{\abovedisplayskip}{\GridStep}%
  \setlength{\belowdisplayskip}{\GridStep}%
  \setlength{\abovedisplayshortskip}{\GridStep}%
  \setlength{\belowdisplayshortskip}{\GridStep}%
  \setlength{\jot}{\GridStep}%
}

% Preserve the document class heading fonts; make only their vertical spacing grid-based.
\titlespacing*{\section}{0pt}{\GridStep}{\GridStep}
\titlespacing*{\subsection}{0pt}{\GridStep}{\GridStep}
\titlespacing*{\subsubsection}{0pt}{\GridStep}{\GridStep}

% Lists have no non-grid vertical glue; line leading remains a grid multiple.
\setlist{topsep=0pt,partopsep=0pt,itemsep=0pt,parsep=0pt}
% The caption gap follows the grid when enabled and returns to the document's
% original gap while inside a gridautoff scope. Keep caption font untouched.
\newcommand{\GridAutoCaptionSkip}{%
  \ifGridAutoEnabled
    \the\GridStep
  \else
    \the\GridAutoOriginalAboveCaptionSkip
  \fi
}
\captionsetup{skip=\GridAutoCaptionSkip}

% Automatic re-snap after common standard blocks. No body commands required.
\AtEndEnvironment{equation}{\GridAutoMark}
\AtEndEnvironment{equation*}{\GridAutoMark}
\AtEndEnvironment{align}{\GridAutoMark}
\AtEndEnvironment{align*}{\GridAutoMark}
\AtEndEnvironment{gather}{\GridAutoMark}
\AtEndEnvironment{gather*}{\GridAutoMark}
\AtEndEnvironment{multline}{\GridAutoMark}
\AtEndEnvironment{multline*}{\GridAutoMark}
\AtEndEnvironment{flalign}{\GridAutoMark}
\AtEndEnvironment{flalign*}{\GridAutoMark}
\AtEndEnvironment{alignat}{\GridAutoMark}
\AtEndEnvironment{alignat*}{\GridAutoMark}
\AtEndEnvironment{displaymath}{\GridAutoMark}
\AtEndEnvironment{itemize}{\GridAutoMark}
\AtEndEnvironment{enumerate}{\GridAutoMark}
\AtEndEnvironment{description}{\GridAutoMark}
\AtEndEnvironment{quote}{\GridAutoMark}
\AtEndEnvironment{quotation}{\GridAutoMark}
\AtEndEnvironment{center}{\GridAutoMark}
\AtEndEnvironment{flushleft}{\GridAutoMark}
\AtEndEnvironment{flushright}{\GridAutoMark}
\AtEndEnvironment{figure}{\GridAutoMark}
\AtEndEnvironment{table}{\GridAutoMark}
\AtEndEnvironment{figure*}{\PackageWarningNoLine{gridauto}{figure* is still a floating object; strict grid alignment around it is not guaranteed}}
\AtEndEnvironment{table*}{\PackageWarningNoLine{gridauto}{table* is still a floating object; strict grid alignment around it is not guaranteed}}

% Also catch the standard \[ ... \] display-math form.
\makeatletter
\apptocmd{\]}{\GridAutoMark}{}{}
\makeatother

% Optional red grid overlay for checking the rendered pages: load with [debug].
\ifGridAutoDebug
  \RequirePackage{tikz}
  \RequirePackage{eso-pic}
  \AtBeginDocument{\AddToShipoutPictureBG{\AtTextUpperLeft{\showdebugpagegrid}}}
\fi

\endinput
