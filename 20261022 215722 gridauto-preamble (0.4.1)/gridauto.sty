\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gridauto}[2026/10/22 v0.4.1 heading-spacing fix]

% This package is a controlled, best-effort grid helper for standard
% article/report/book documents. It requires LuaLaTeX and returntogrid.
% It is not a universal page-output replacement; see the limitations below.

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{gridauto}{LuaLaTeX is required}{Compile this document with LuaLaTeX.}
\fi

\newif\ifGridAutoDebug
\GridAutoDebugfalse
\DeclareOption{debug}{\GridAutoDebugtrue}
\ProcessOptions\relax

\RequirePackage{etoolbox}
\RequirePackage{amsmath}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{returntogrid}

% Save pre-grid settings so a scoped disable can locally restore the normal
% baseline, display skips, title spacing and page-bottom behaviour.
\newlength{\GridAutoNaturalBaseline}
\newlength{\GridAutoOriginalTopskip}
\newlength{\GridAutoOriginalParskip}
\newskip\GridAutoOriginalAboveDisplaySkip
\newskip\GridAutoOriginalBelowDisplaySkip
\newskip\GridAutoOriginalAboveDisplayShortSkip
\newskip\GridAutoOriginalBelowDisplayShortSkip
\newskip\GridAutoOriginalAboveCaptionSkip
\newskip\GridAutoOriginalBelowCaptionSkip
\newlength{\GridAutoOriginalJot}
\setlength{\GridAutoNaturalBaseline}{12pt}
\setlength{\GridAutoOriginalTopskip}{\topskip}
\setlength{\GridAutoOriginalParskip}{\parskip}
\GridAutoOriginalAboveDisplaySkip=\abovedisplayskip
\GridAutoOriginalBelowDisplaySkip=\belowdisplayskip
\GridAutoOriginalAboveDisplayShortSkip=\abovedisplayshortskip
\GridAutoOriginalBelowDisplayShortSkip=\belowdisplayshortskip
\GridAutoOriginalAboveCaptionSkip=\abovecaptionskip
\GridAutoOriginalBelowCaptionSkip=\belowcaptionskip
\setlength{\GridAutoOriginalJot}{\jot}

\makeatletter
\let\GridAutoOriginalTextBottom\@textbottom
\@ifundefined{ttls@section}{}{\let\GridAutoOriginalSectionSpacing\ttls@section}
\@ifundefined{ttls@subsection}{}{\let\GridAutoOriginalSubsectionSpacing\ttls@subsection}
\@ifundefined{ttls@subsubsection}{}{\let\GridAutoOriginalSubsubsectionSpacing\ttls@subsubsection}
\@ifundefined{ttls@paragraph}{}{\let\GridAutoOriginalParagraphSpacing\ttls@paragraph}
\@ifundefined{ttls@subparagraph}{}{\let\GridAutoOriginalSubparagraphSpacing\ttls@subparagraph}
\@ifundefined{ttlf@paragraph}{}{\let\GridAutoOriginalParagraphFormat\ttlf@paragraph}
\@ifundefined{ttlf@subparagraph}{}{\let\GridAutoOriginalSubparagraphFormat\ttlf@subparagraph}
\@ifundefined{enit@@list}{\let\GridAutoOriginalListSpacing\relax}{\let\GridAutoOriginalListSpacing\enit@@list}
\makeatother

\newlength{\GridStep}
\setlength{\GridStep}{14pt}
\newif\ifGridAutoEnabled
\newif\ifGridAutoPending
\newif\ifGridAutoBusy
\newif\ifGridAutoHeadingActive
\newif\ifGridAutoHeadingSnap
\newcounter{GridAutoHeading}
\GridAutoEnabledtrue
\GridAutoPendingfalse
\GridAutoBusyfalse
\GridAutoHeadingActivefalse
\GridAutoHeadingSnapfalse

\makeatletter
% Unique, repeatable labels for each heading across compilations.
% Heading labels are keyed by heading level, current number and title hash.
% This prevents stale positional data from being reused for a different heading
% when a heading is inserted, deleted, renamed or reordered in the source.
\ExplSyntaxOn
\cs_new_protected:Npn \GridAutoMakeHeadingLabel #1#2
  {
    \cs_set:Npx \GridAutoStableHeadingLabel
      { gridauto-heading-#1-\use:c { the#1 }-\str_mdfive_hash:n {#2} }
  }
\ExplSyntaxOff
\newcommand{\GridAutoStableHeadingLabel}{}
\newcommand{\GridAutoHeadingLabel}{\GridAutoStableHeadingLabel}
\newcommand{\GridAutoHeadingSave}{\returntogrid[save=\GridAutoHeadingLabel]}

% The before/after values are non-negative integer counts of \GridStep.
% They are evaluated at typesetting time, so changing \GridAutoSetup also
% changes all configured heading spaces.
\newcommand{\GridAutoBeforeDim}[1]{%
  \csname GridAutoBeforeLines@#1\endcsname\GridStep}
\newcommand{\GridAutoAfterDim}[1]{%
  \csname GridAutoAfterLines@#1\endcsname\GridStep}

\newcommand{\GridAutoBeforeHeading}{%
  \ifGridAutoEnabled
    % Normal text flow already advances in grid steps. Only correct a heading
    % when a preceding non-text block (equation/list/float/etc.) explicitly
    % marked the baseline as pending; correcting every heading creates a
    % chain of interdependent aux skips that can look like an extra blank line.
    \ifGridAutoPending
      \global\GridAutoPendingfalse
      \stepcounter{GridAutoHeading}%
      % Defer the correction until titlesec has handled its before-space.
      \if@nobreak
        \global\GridAutoHeadingSnapfalse
      \else
        \global\GridAutoHeadingSnaptrue
      \fi
      \global\GridAutoHeadingActivetrue
    \else
      \global\GridAutoHeadingActivefalse
      \global\GridAutoHeadingSnapfalse
    \fi
  \fi
}

% Public setup command: use in the preamble, e.g. \GridAutoSetup{14pt}.
\newcommand{\GridAutoSetup}[1]{%
  \setlength{\GridStep}{#1}%
  \setlength{\topskip}{\GridStep}%
  \setlength{\parskip}{0pt}%
  \raggedbottom
  \returntogridsetup{step=\GridStep,offset=\topskip}%
}
\GridAutoSetup{14pt}

% Public heading-spacing API.
% Usage: \GridAutoHeadingSpacing{section}{1}{2}
%         \GridAutoHeadingBefore{section}{0}
%         \GridAutoHeadingAfter{subsection}{2}
\def\GridAutoStoreLineCount#1#2{%
  \ifnum\numexpr#2\relax<0
    \PackageError{gridauto}{Heading spacing must be non-negative}{Use an integer number of grid lines, including 0.}%
    \expandafter\def\csname #1\endcsname{0}%
  \else
    \expandafter\edef\csname #1\endcsname{\number\numexpr#2\relax}%
  \fi
}

\def\GridAutoApply@chapter{}% Chapter spacing is applied in the class macro.
\def\GridAutoApply@section{%
  \titlespacing*{\section}{0pt}{\GridAutoBeforeDim{section}}{\GridAutoAfterDim{section}}}
\def\GridAutoApply@subsection{%
  \titlespacing*{\subsection}{0pt}{\GridAutoBeforeDim{subsection}}{\GridAutoAfterDim{subsection}}}
\def\GridAutoApply@subsubsection{%
  \titlespacing*{\subsubsection}{0pt}{\GridAutoBeforeDim{subsubsection}}{\GridAutoAfterDim{subsubsection}}}
\def\GridAutoApply@paragraph{%
  \titlespacing*{\paragraph}{0pt}{\GridAutoBeforeDim{paragraph}}{\GridAutoAfterDim{paragraph}}}
\def\GridAutoApply@subparagraph{%
  \titlespacing*{\subparagraph}{\parindent}{\GridAutoBeforeDim{subparagraph}}{\GridAutoAfterDim{subparagraph}}}

\newcommand{\GridAutoHeadingSpacing}[3]{%
  \@ifundefined{GridAutoBeforeLines@#1}{%
    \PackageError{gridauto}{Unknown heading level `#1'}%
      {Allowed values: chapter, section, subsection, subsubsection, paragraph, subparagraph.}%
  }{%
    \GridAutoStoreLineCount{GridAutoBeforeLines@#1}{#2}%
    \GridAutoStoreLineCount{GridAutoAfterLines@#1}{#3}%
    \GridAutoApplyHeadingSpacing{#1}%
  }%
}
\newcommand{\GridAutoApplyHeadingSpacing}[1]{%
  \@ifundefined{GridAutoApply@#1}{%
    \PackageError{gridauto}{Unknown heading level `#1'}%
      {Allowed values: chapter, section, subsection, subsubsection, paragraph, subparagraph.}%
  }{\csname GridAutoApply@#1\endcsname}%
}
\newcommand{\GridAutoHeadingBefore}[2]{%
  \@ifundefined{GridAutoAfterLines@#1}{%
    \PackageError{gridauto}{Unknown heading level `#1'}{Check the heading level name.}%
  }{\GridAutoHeadingSpacing{#1}{#2}{\csname GridAutoAfterLines@#1\endcsname}}%
}
\newcommand{\GridAutoHeadingAfter}[2]{%
  \@ifundefined{GridAutoBeforeLines@#1}{%
    \PackageError{gridauto}{Unknown heading level `#1'}{Check the heading level name.}%
  }{\GridAutoHeadingSpacing{#1}{\csname GridAutoBeforeLines@#1\endcsname}{#2}}%
}
\let\GridAutoSetHeadingSpacing\GridAutoHeadingSpacing
% Define all supported keys before the default spacing configuration is run.
\def\GridAutoBeforeLines@chapter{0}\def\GridAutoAfterLines@chapter{0}%
\def\GridAutoBeforeLines@section{0}\def\GridAutoAfterLines@section{0}%
\def\GridAutoBeforeLines@subsection{0}\def\GridAutoAfterLines@subsection{0}%
\def\GridAutoBeforeLines@subsubsection{0}\def\GridAutoAfterLines@subsubsection{0}%
\def\GridAutoBeforeLines@paragraph{0}\def\GridAutoAfterLines@paragraph{0}%
\def\GridAutoBeforeLines@subparagraph{0}\def\GridAutoAfterLines@subparagraph{0}%
\makeatother

\newcommand{\GridAutoMark}{%
  \ifGridAutoEnabled\global\GridAutoPendingtrue\fi
}

\makeatletter

% Disable the grid locally. Use in a brace group or through the gridautoff
% environment; assignments intentionally remain local except stale pending
% corrections, which are cleared so they cannot leak past the excluded block.
\newcommand{\GridAutoOff}{%
  \GridAutoEnabledfalse
  \global\GridAutoPendingfalse
  \global\GridAutoHeadingActivefalse
  \baselineskip=\GridAutoNaturalBaseline\relax
  \topskip=\GridAutoOriginalTopskip\relax
  \parskip=\GridAutoOriginalParskip\relax
  \abovedisplayskip=\GridAutoOriginalAboveDisplaySkip
  \belowdisplayskip=\GridAutoOriginalBelowDisplaySkip
  \abovedisplayshortskip=\GridAutoOriginalAboveDisplayShortSkip
  \belowdisplayshortskip=\GridAutoOriginalBelowDisplayShortSkip
  \abovecaptionskip=\GridAutoOriginalAboveCaptionSkip
  \belowcaptionskip=\GridAutoOriginalBelowCaptionSkip
  \jot=\GridAutoOriginalJot
  \let\@textbottom\GridAutoOriginalTextBottom
  \@ifundefined{GridAutoOriginalSectionSpacing}{}{%
    \let\ttls@section\GridAutoOriginalSectionSpacing}%
  \@ifundefined{GridAutoOriginalSubsectionSpacing}{}{%
    \let\ttls@subsection\GridAutoOriginalSubsectionSpacing}%
  \@ifundefined{GridAutoOriginalSubsubsectionSpacing}{}{%
    \let\ttls@subsubsection\GridAutoOriginalSubsubsectionSpacing}%
  \@ifundefined{GridAutoOriginalParagraphSpacing}{}{%
    \let\ttls@paragraph\GridAutoOriginalParagraphSpacing}%
  \@ifundefined{GridAutoOriginalSubparagraphSpacing}{}{%
    \let\ttls@subparagraph\GridAutoOriginalSubparagraphSpacing}%
  \@ifundefined{GridAutoOriginalParagraphFormat}{}{%
    \let\ttlf@paragraph\GridAutoOriginalParagraphFormat}%
  \@ifundefined{GridAutoOriginalSubparagraphFormat}{}{%
    \let\ttlf@subparagraph\GridAutoOriginalSubparagraphFormat}%
  \let\enit@@list\GridAutoOriginalListSpacing
}
\let\GridAutoDisable\GridAutoOff
\newenvironment{gridautoff}{\GridAutoOff}{}

% Apply correction only when the pre-hook marked an irregular preceding block,
% and only after titlesec has applied the heading's before-space. Stable labels
% avoid stale .aux positions being reused for a different heading after edits.
\@ifundefined{ttl@select}{}{%
  \let\GridAutoOriginalTtlSelect\ttl@select
  \def\ttl@select#1#2#3#4{%
    \ifGridAutoHeadingActive
      \GridAutoMakeHeadingLabel{#1}{#4}%
      \ifGridAutoHeadingSnap
        \returntogrid[use=\GridAutoHeadingLabel]%
      \fi
      \GridAutoOriginalTtlSelect{#1}{#2}{#3}{\GridAutoHeadingSave#4}%
      \global\GridAutoHeadingActivefalse
      \global\GridAutoHeadingSnapfalse
    \else
      \GridAutoOriginalTtlSelect{#1}{#2}{#3}{#4}%
    \fi
  }%
}

% In-flow headings: include starred and unstarred forms automatically.
\pretocmd{\section}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook section}}
\pretocmd{\subsection}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook subsection}}
\pretocmd{\subsubsection}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook subsubsection}}
\pretocmd{\paragraph}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook paragraph}}
\pretocmd{\subparagraph}{\GridAutoBeforeHeading}{}{\PackageWarning{gridauto}{Could not hook subparagraph}}

% Page-opening chapter headings retain the document class's typography,
% but their outer skips are expressed in grid lines. The original class spacing
% is restored whenever gridautoff / \GridAutoOff is active.
\@ifundefined{chapter}{}{%
  \@ifundefined{ttl@save@mkchap}{}{%
    \patchcmd{\ttl@save@mkchap}{\vspace*{50\p@}}%
      {\ifGridAutoEnabled\vspace*{\GridAutoBeforeDim{chapter}}\else\vspace*{50\p@}\fi}%
      {}{\PackageWarning{gridauto}{Could not patch numbered chapter top spacing}}%
    \patchcmd{\ttl@save@mkchap}{\vskip 40\p@}%
      {\ifGridAutoEnabled\vskip\GridAutoAfterDim{chapter}\else\vskip 40\p@\fi}%
      {}{\PackageWarning{gridauto}{Could not patch numbered chapter bottom spacing}}%
    \patchcmd{\ttl@save@mkchap}{\vskip 20\p@}%
      {\ifGridAutoEnabled\vskip\GridStep\else\vskip 20\p@\fi}%
      {}{\PackageWarning{gridauto}{Could not patch chapter label-title spacing}}%
  }%
  \@ifundefined{ttl@save@mkschap}{}{%
    \patchcmd{\ttl@save@mkschap}{\vspace*{50\p@}}%
      {\ifGridAutoEnabled\vspace*{\GridAutoBeforeDim{chapter}}\else\vspace*{50\p@}\fi}%
      {}{\PackageWarning{gridauto}{Could not patch unnumbered chapter top spacing}}%
    \patchcmd{\ttl@save@mkschap}{\vskip 40\p@}%
      {\ifGridAutoEnabled\vskip\GridAutoAfterDim{chapter}\else\vskip 40\p@\fi}%
      {}{\PackageWarning{gridauto}{Could not patch unnumbered chapter bottom spacing}}%
  }%
  \pretocmd{\chapter}{\global\GridAutoPendingfalse}{}{}%
}
\@ifundefined{part}{}{%
  \pretocmd{\part}{\global\GridAutoPendingfalse}{}{}
}

% Keep each normal paragraph's baseline interval on an integer multiple
% of the grid. Very large font sizes use two grid steps to avoid collisions.
\AddToHook{selectfont}{%
  % Capture the font's natural leading before applying the grid override.
  \GridAutoNaturalBaseline=\baselineskip
  \ifGridAutoEnabled
    \dimen@=\f@size pt\relax
    \ifdim\dimen@>\GridStep
      \baselineskip=2\GridStep
    \else
      \baselineskip=\GridStep
    \fi
    \lineskip=0pt
    \lineskiplimit=-1000pt
  \fi
}

% If a standard block ended, snap the following main-text paragraph to the
% grid. Do not insert a correction inside an inner box/minipage.
\AddToHook{para/begin}{%
  \ifGridAutoEnabled
    \ifGridAutoPending
      \ifinner
        % Keep the flag pending; a correction inside a box is unsafe.
      \else
        \global\GridAutoPendingfalse
        \ifGridAutoBusy\else
          \global\GridAutoBusytrue
          \returntogrid
          \global\GridAutoBusyfalse
        \fi
      \fi
    \fi
  \fi
}

% Force ordinary figure/table environments to remain in source order.
% This is necessary because a relocated top float can break the grid.
% Double-column floats are not forced and produce warnings below.
\let\GridAutoOriginalXfloat\@xfloat
\def\@xfloat#1[#2]{%
  \ifGridAutoEnabled
    \ifstrequal{#1}{figure}{\GridAutoOriginalXfloat#1[H]}{%
      \ifstrequal{#1}{table}{\GridAutoOriginalXfloat#1[H]}{%
        \GridAutoOriginalXfloat#1[#2]}%
    }%
  \else
    \GridAutoOriginalXfloat#1[#2]%
  \fi
}
\makeatother

% Textual block spacing.
\AtBeginDocument{%
  \setlength{\parskip}{0pt}%
  \setlength{\abovedisplayskip}{\GridStep}%
  \setlength{\belowdisplayskip}{\GridStep}%
  \setlength{\abovedisplayshortskip}{\GridStep}%
  \setlength{\belowdisplayshortskip}{\GridStep}%
  \setlength{\jot}{\GridStep}%
}

% A paragraph and subparagraph need a vertical after-space to make the
% configured "below" value meaningful, so render them as block headings
% rather than the standard classes' run-in headings. Font and numbering remain
% class-like; subparagraph keeps its traditional left indentation.
\makeatletter
\titleformat{\paragraph}[block]
  {\normalfont\normalsize\bfseries}{\@seccntformat{paragraph}}{0pt}{}
\titleformat{\subparagraph}[block]
  {\normalfont\normalsize\bfseries}{\@seccntformat{subparagraph}}{0pt}{}
\makeatother

% In consecutive headings, use only the after-space of the preceding heading;
% suppress the next heading's before-space. This guarantees no accumulation
% (the documented titlesec `aftersep` behavior), including when the title
% commands add penalties between their vertical skips.
\makeatletter
\let\ttl@titlespace\@gobble
\makeatother

% Default settings, expressed in line-grid units. All values may be zero.
% Chapter defaults approximate the standard book/report chapter whitespace.
\GridAutoHeadingSpacing{chapter}{4}{3}
\GridAutoHeadingSpacing{section}{1}{1}
\GridAutoHeadingSpacing{subsection}{1}{1}
\GridAutoHeadingSpacing{subsubsection}{1}{1}
\GridAutoHeadingSpacing{paragraph}{1}{0}
\GridAutoHeadingSpacing{subparagraph}{1}{0}

% Lists have no non-grid vertical glue; line leading remains a grid multiple.
\setlist{topsep=0pt,partopsep=0pt,itemsep=0pt,parsep=0pt}
% The caption gap follows the grid when enabled and returns to the document's
% original gap while inside a gridautoff scope. Keep caption font untouched.
\newcommand{\GridAutoCaptionSkip}{%
  \ifGridAutoEnabled
    \the\GridStep
  \else
    \the\GridAutoOriginalAboveCaptionSkip
  \fi
}
\captionsetup{skip=\GridAutoCaptionSkip}

% Automatic re-snap after common standard blocks. No body commands required.
\AtEndEnvironment{equation}{\GridAutoMark}
\AtEndEnvironment{equation*}{\GridAutoMark}
\AtEndEnvironment{align}{\GridAutoMark}
\AtEndEnvironment{align*}{\GridAutoMark}
\AtEndEnvironment{gather}{\GridAutoMark}
\AtEndEnvironment{gather*}{\GridAutoMark}
\AtEndEnvironment{multline}{\GridAutoMark}
\AtEndEnvironment{multline*}{\GridAutoMark}
\AtEndEnvironment{flalign}{\GridAutoMark}
\AtEndEnvironment{flalign*}{\GridAutoMark}
\AtEndEnvironment{alignat}{\GridAutoMark}
\AtEndEnvironment{alignat*}{\GridAutoMark}
\AtEndEnvironment{displaymath}{\GridAutoMark}
\AtEndEnvironment{itemize}{\GridAutoMark}
\AtEndEnvironment{enumerate}{\GridAutoMark}
\AtEndEnvironment{description}{\GridAutoMark}
\AtEndEnvironment{quote}{\GridAutoMark}
\AtEndEnvironment{quotation}{\GridAutoMark}
\AtEndEnvironment{center}{\GridAutoMark}
\AtEndEnvironment{flushleft}{\GridAutoMark}
\AtEndEnvironment{flushright}{\GridAutoMark}
\AtEndEnvironment{figure}{\GridAutoMark}
\AtEndEnvironment{table}{\GridAutoMark}
\AtEndEnvironment{figure*}{\PackageWarningNoLine{gridauto}{figure* is still a floating object; strict grid alignment around it is not guaranteed}}
\AtEndEnvironment{table*}{\PackageWarningNoLine{gridauto}{table* is still a floating object; strict grid alignment around it is not guaranteed}}

% Also catch the standard \[ ... \] display-math form.
\makeatletter
\apptocmd{\]}{\GridAutoMark}{}{}
\makeatother

% Optional red grid overlay for checking the rendered pages: load with [debug].
\ifGridAutoDebug
  \RequirePackage{tikz}
  \RequirePackage{eso-pic}
  \AtBeginDocument{\AddToShipoutPictureBG{\AtTextUpperLeft{\showdebugpagegrid}}}
\fi

\endinput
